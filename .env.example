# Comma-separated allowlist for open()
KAIZEN_ALLOWED_URL_SCHEMES=data:,about:blank

# Optional PageBrain model wiring (runtime scorer)
# After running scripts/pagebrain_ranker_eval.py, you can point the resolver
# at the generated weights file (reports/pagebrain_model_weights.json) by
# setting a default model id and mapping it to the weights path.
#
# Example:
# KAIZEN_PAGEBRAIN_DEFAULT_MODEL=pagebrain-gbm-v1
# KAIZEN_PAGEBRAIN_MODELS={"pagebrain-gbm-v1": "reports/pagebrain_model_weights.json"}

# Optional: API key for PageBrain LLM ranker when backend is "openai".
# KAIZEN_PAGEBRAIN_LLM_API_KEY=sk-...
