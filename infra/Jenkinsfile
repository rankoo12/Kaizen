// infra/Jenkinsfile — Kaizen CI (Docker agent runs tests; no API container)
// This pipeline:
//  - checks out the repo
//  - runs tests inside a Playwright-ready Docker agent by calling scripts/ci.sh
//  - publishes JUnit results and archives artifacts (reports/, logs/, snapshots/)

pipeline {
  agent {
    docker {
      image 'mcr.microsoft.com/playwright/python:v1.55.0-jammy'
      // run as root to allow apt/pip installs; cache pip between runs
      args '-u root -v $HOME/.cache/pip:/root/.cache/pip:rw'
      reuseNode true
    }
  }

  options {
    ansiColor('xterm')
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
  }

  environment {
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD = '1'
    PYTEST_OPTS = ''   // set to '-vv' locally if you want more verbosity
    PYTHONUNBUFFERED = '1'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    // Assumes scripts/ci.sh is the bash script that installs make/deps, installs Playwright, and runs `make ci`.
    stage('Test') {
      steps {
        sh 'bash scripts/ci.sh'
      }
    }

    stage('API Smoke') {
      steps {
        sh 'python scripts/ci_sanity.py'
      }
    }

    // If you want to build a Docker image after tests pass, we can add a Build stage here later.
    // If you want to boot the API in CI, we can add an "API Smoke" stage or switch to the compose-based flow.
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: 'reports/junit-*.xml'
      archiveArtifacts artifacts: 'reports/**,logs/**,snapshots/**', fingerprint: true, allowEmptyArchive: true
    }
  }
}
